#include "Base.xcconfig"

APP_ENVIRONMENT = Staging
PRODUCT_BUNDLE_IDENTIFIER = com.ethanherrera.tunedin.staging
APP_DISPLAY_NAME = tunedIn Staging
AUTH_EXPERIENCE = NativeSocial
GOOGLE_IOS_CLIENT_ID = REPLACE_WITH_STAGING_GOOGLE_IOS_CLIENT_ID
GOOGLE_SERVER_CLIENT_ID = REPLACE_WITH_STAGING_GOOGLE_SERVER_CLIENT_ID
GOOGLE_REVERSED_CLIENT_ID = REPLACE_WITH_STAGING_GOOGLE_REVERSED_CLIENT_ID
// Set DEVELOPMENT_TEAM in the ignored local file for a manual Xcode archive.
SUPABASE_URL = https:/$(TUNEDIN_URL_SLASH)YOUR_STAGING_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = REPLACE_WITH_STAGING_PUBLISHABLE_KEY
POSTHOG_PROJECT_TOKEN = REPLACE_WITH_STAGING_PROJECT_TOKEN
POSTHOG_PROJECT_ID = 507318
POSTHOG_HOST = https:/$(TUNEDIN_URL_SLASH)us.i.posthog.com
