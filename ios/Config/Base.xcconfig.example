PRODUCT_BUNDLE_IDENTIFIER = com.ethanherrera.tunedin
APP_DISPLAY_NAME = tunedIn
AUTH_CALLBACK_SCHEME = $(PRODUCT_BUNDLE_IDENTIFIER)
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TUNEDIN_URL_SLASH = /
TUNEDIN_USE_LOCAL_AUTH_STORAGE = NO
TUNEDIN_GIT_SHA = local
AUTH_EXPERIENCE = Email
GOOGLE_IOS_CLIENT_ID = disabled.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID = disabled.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.disabled
